# Officially-supported Open WebUI branding knobs (docs.openwebui.com/reference/env-configuration).
# Source before `open-webui serve`:  set -a && source integrations/openwebui/branding/.env.openwebui && set +a

WEBUI_NAME="Rimini Street Knowledge Assistant"

# Point this at wherever you're serving branding/favicon.png from (a file:// path
# works for a single local instance; use a real URL if Open WebUI runs elsewhere).
WEBUI_FAVICON_URL="integrations/openwebui/branding/favicon.png"
