# Copy to .env and fill in. Backends are the "flip" point — change these when
# real infra (Postgres/Qdrant/Azure Blob/Celery) becomes available.
#
# --- Docker Compose stack (docker-compose.yml) ---
# `docker compose up` does NOT read this file — the api/worker services'
# environment is set directly in docker-compose.yml, and Postgres/Redis run as
# compose services of their own. This file is only for the plain local-dev
# workflow (`uvicorn`/`python -m app.worker` run directly on the host). To
# instead point a host-run uvicorn/worker at the compose stack's postgres/redis
# containers, uncomment the `ports:` lines for those two services in
# docker-compose.yml, then set here:
#   METADATA_BACKEND=postgres
#   VECTOR_BACKEND=pgvector
#   QUEUE_BACKEND=postgres
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_ingestion
#   REDIS_URL=redis://localhost:6379

APP_ENV=local

# storage backends (local for now)
METADATA_BACKEND=sqlite       # sqlite | postgres
BLOB_BACKEND=localfs
VECTOR_BACKEND=localfile      # localfile | pgvector
QUEUE_BACKEND=sqlite          # sqlite | postgres

DATA_DIR=data

# --- Postgres (only used when METADATA_BACKEND/QUEUE_BACKEND=postgres or VECTOR_BACKEND=pgvector) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_ingestion
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# --- pgvector tuning ---
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=100
PGVECTOR_CANDIDATE_MULTIPLIER=4
PGVECTOR_MIN_CANDIDATES=50

# --- global/firm-wide knowledge base ---
# Only an admin belonging to this tenant may POST /ingest with scope=global
# (visible to every tenant). Set via `python -m scripts.seed --platform`. Leave
# blank to disable global publishing entirely.
PLATFORM_TENANT_ID=

# --- LiteLLM gateway (vision LLM used for image/scanned-page transcription) ---
# Can stay blank — an admin can set these live from the onboarding UI
# (POST /onboarding/gateway-config), persisted to the system_config table, no
# restart needed. Set them here only if you want an org-wide default baked in
# at deploy time.
#
# If this gateway is only reachable through the Foundry landing-zone Bastion
# tunnel (`deploy.sh gateway`/`foundry`), that tunnel binds to 127.0.0.1 on
# your host only. Running this app under docker-compose needs one extra step
# for the api/worker containers to reach it — see docker-compose.yml's
# `extra_hosts` comment and scripts/gateway-relay.sh. Running it directly on
# the host (this file's path, `uvicorn`/`python -m app.ingest.worker`) needs
# no such step — 127.0.0.1 here already means the same loopback the tunnel is
# bound to.
LITELLM_BASE_URL=https://litellm-gateway.delightfulpebble-214bf13c.eastus2.azurecontainerapps.io
LITELLM_API_KEY=your-litellm-api-key-here
VISION_MODEL=claude7-sonnet-5

# --- embeddings ---
# minilm  = real local ONNX all-MiniLM-L6-v2 (384-dim), no gateway needed (default).
# gateway = LiteLLM embeddings (only if an embedding model is provisioned there).
EMBEDDING_PROVIDER=minilm
EMBEDDING_DIM=384
# EMBEDDING_MODEL=            # set only when EMBEDDING_PROVIDER=gateway

# --- semantic answer cache (optional) ---
# Blank = disabled (query path unchanged). Set to a Redis with the RediSearch
# module (Redis Stack, or Redis 8+) to cache generated answers per-user and serve
# same/similar questions instantly. e.g. redis://localhost:6379
REDIS_URL=
CACHE_INDEX_NAME=ans_idx
CACHE_SIMILARITY_THRESHOLD=0.95   # min cosine sim to reuse a cached answer (1.0=exact)
CACHE_TTL_SECONDS=86400           # per-entry TTL (staleness backstop)

# --- limits / worker ---
MAX_UPLOAD_MB=50
MAX_ATTEMPTS=5
WORKER_POLL_SECONDS=1.0
