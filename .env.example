# Compose reads .env for substitution; host-run Python also reads this file.
# Select exactly one profile. Development starts API, worker, Postgres and Redis.
COMPOSE_PROFILES=development

# Host-run API/worker use these loopback ports from the development profile.
# Container services use their internal postgres/redis addresses instead.
APP_ENV=development
DATA_DIR=data
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/rag_ingestion
REDIS_URL=redis://localhost:56380
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# A deployment operator provisions these IDs; tenant signup is not operator signup.
PLATFORM_TENANT_ID=
OPERATOR_USER_IDS=[]
GATEWAY_ALLOWED_ORIGINS=[]

# Required for the default gateway embeddings, answers and image/scanned-page
# extraction. Use model aliases available on your gateway.
LITELLM_BASE_URL=
LITELLM_API_KEY=
VISION_MODEL=claude-sonnet-5
CHAT_MODEL=gpt-5-nano
LAYOUT_ENABLED=true
LAYOUT_MODEL_PATH=models/doclayout-yolo/doclayout_yolo_docstructbench_imgsz1024.pt
LAYOUT_DEVICE=cpu
LAYOUT_IMAGE_SIZE=1024
LAYOUT_CONFIDENCE=0.2
# For a host-side gateway tunnel, see scripts/gateway-relay.sh.
# GATEWAY_HOSTNAME=your-gateway-hostname

EMBEDDING_PROVIDER=gateway
EMBEDDING_DIM=1536
EMBED_BATCH_SIZE=64
EMBEDDING_MODEL=text-embedding-3-large
# Provider model identity; use a deployment revision when your gateway supplies one.
EMBEDDING_REVISION=text-embedding-3-large
RERANKER_PROVIDER=cross_encoder
CACHE_INDEX_NAME=ans_te3_large_1536
PARSE_TIMEOUT_SECONDS=240

# Production profile: provision external Postgres/pgvector and Redis Stack,
# initialize schema with a migration identity, then set these values.
# Use a separate Compose project name and select only the production profile.
# COMPOSE_PROFILES=production
# RAG_RELEASE_IMAGE=your-registry/rag@sha256:your-release-digest
# PRODUCTION_GATEWAY_ORIGIN=https://your-gateway.example.com
# PRODUCTION_CACHE_INDEX=ans_release_1
# PRODUCTION_TLS_HOSTNAME=rag.example.com
# PRODUCTION_BIND_ADDRESS=127.0.0.1
# PRODUCTION_HTTPS_PORT=8443
# RUNTIME_DATABASE_SECRET=/absolute/path/runtime-database-url
# RUNTIME_REDIS_SECRET=/absolute/path/runtime-redis-url
# GATEWAY_KEY_SECRET=/absolute/path/gateway-api-key
# TLS_CERTIFICATE_FILE=/absolute/path/certificate.pem
# TLS_KEY_FILE=/absolute/path/private-key.pem
